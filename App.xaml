<Application x:Class="PreservaMetadados.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PreservaMetadados"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Dark.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignColors;component/Themes/Recommended/Primary/MaterialDesignColor.Blue.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignColors;component/Themes/Recommended/Accent/MaterialDesignColor.LightBlue.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- ══════════════════════════════════════════════ -->
            <!-- CYBER TECH DARK — DESIGN TOKENS              -->
            <!-- ══════════════════════════════════════════════ -->

            <!-- Background Colors -->
            <Color x:Key="AppBackgroundColor">#040914</Color>
            <Color x:Key="CardBackgroundColor">#0A1628</Color>
            <Color x:Key="CardBackgroundLighterColor">#0F1F38</Color>
            <Color x:Key="CardBorderColor">#0D3B7A</Color>
            <Color x:Key="RowHoverColor">#0D2A50</Color>
            <Color x:Key="RowAlternateColor">#080E1C</Color>

            <!-- Neon Accent Colors -->
            <Color x:Key="NeonBlueColor">#0066FF</Color>
            <Color x:Key="NeonCyanColor">#00D2FF</Color>
            <Color x:Key="NeonGreenColor">#00E676</Color>
            <Color x:Key="NeonYellowColor">#FFD54F</Color>

            <!-- Text Colors -->
            <Color x:Key="TextPrimaryColor">#FFFFFF</Color>
            <Color x:Key="TextSecondaryColor">#8899AA</Color>
            <Color x:Key="TextMutedColor">#556677</Color>

            <!-- SolidColorBrushes -->
            <SolidColorBrush x:Key="AppBackground" Color="{StaticResource AppBackgroundColor}"/>
            <SolidColorBrush x:Key="CardBackground" Color="{StaticResource CardBackgroundColor}"/>
            <SolidColorBrush x:Key="CardBackgroundLighter" Color="{StaticResource CardBackgroundLighterColor}"/>
            <SolidColorBrush x:Key="CardBorder" Color="{StaticResource CardBorderColor}"/>
            <SolidColorBrush x:Key="RowHover" Color="{StaticResource RowHoverColor}"/>
            <SolidColorBrush x:Key="RowAlternate" Color="{StaticResource RowAlternateColor}"/>

            <SolidColorBrush x:Key="NeonBlue" Color="{StaticResource NeonBlueColor}"/>
            <SolidColorBrush x:Key="NeonCyan" Color="{StaticResource NeonCyanColor}"/>
            <SolidColorBrush x:Key="NeonGreen" Color="{StaticResource NeonGreenColor}"/>
            <SolidColorBrush x:Key="NeonYellow" Color="{StaticResource NeonYellowColor}"/>

            <SolidColorBrush x:Key="TextPrimary" Color="{StaticResource TextPrimaryColor}"/>
            <SolidColorBrush x:Key="TextSecondary" Color="{StaticResource TextSecondaryColor}"/>
            <SolidColorBrush x:Key="TextMuted" Color="{StaticResource TextMutedColor}"/>

            <!-- Gradient Brushes -->
            <LinearGradientBrush x:Key="HeaderGradient" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#050B18" Offset="0"/>
                <GradientStop Color="#0A1A3A" Offset="0.5"/>
                <GradientStop Color="#050B18" Offset="1"/>
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="BlueButtonGradient" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0044CC" Offset="0"/>
                <GradientStop Color="#0066FF" Offset="1"/>
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="GreenButtonGradient" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#00802B" Offset="0"/>
                <GradientStop Color="#00CC44" Offset="1"/>
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="FooterGradient" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#0033AA" Offset="0"/>
                <GradientStop Color="#0055DD" Offset="0.5"/>
                <GradientStop Color="#0033AA" Offset="1"/>
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="NeonProgressGradient" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#0044CC" Offset="0"/>
                <GradientStop Color="#00D2FF" Offset="0.5"/>
                <GradientStop Color="#0066FF" Offset="1"/>
            </LinearGradientBrush>

            <!-- ══════════════════════════════════════════════ -->
            <!-- CYBER TECH DARK — GLOBAL STYLES               -->
            <!-- ══════════════════════════════════════════════ -->

            <!-- Glow Transfer Button Base -->
            <Style x:Key="GlowButton" TargetType="Button">
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Height" Value="46"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="12" Padding="16,8"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                                <Border.Effect>
                                    <DropShadowEffect ShadowDepth="0" BlurRadius="15" Color="#0066FF" Opacity="0.4"/>
                                </Border.Effect>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect ShadowDepth="0" BlurRadius="22" Color="#0088FF" Opacity="0.7"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Dark CheckBox Style -->
            <Style x:Key="DarkCheckBox" TargetType="CheckBox">
                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                <Setter Property="Background" Value="#081426"/>
                <Setter Property="BorderBrush" Value="#0D3B7A"/>
                <Setter Property="BorderThickness" Value="1.5"/>
                <Setter Property="Margin" Value="0"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <Grid x:Name="RootGrid" Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="BoxBorder"
                                        Grid.Column="0"
                                        Width="18" Height="18"
                                        CornerRadius="3"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                    <Grid x:Name="GlyphGrid">
                                        <!-- Checkmark Glyph -->
                                        <Path x:Name="CheckGlyph"
                                              Data="M 3.5,8.5 L 7,12 L 14.5,4.5"
                                              Stroke="White"
                                              StrokeThickness="2"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"
                                              Visibility="Collapsed"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                        <!-- Indeterminate Glyph -->
                                        <Rectangle x:Name="IndeterminateGlyph"
                                                   Width="10" Height="2.5"
                                                   Fill="White"
                                                   RadiusX="1" RadiusY="1"
                                                   Visibility="Collapsed"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <ContentPresenter Grid.Column="1"
                                                  Margin="8,0,0,0"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <!-- Checked State -->
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="BoxBorder" Property="Background" Value="#0066FF"/>
                                    <Setter TargetName="BoxBorder" Property="BorderBrush" Value="#00D2FF"/>
                                    <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="BoxBorder" Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect ShadowDepth="0" BlurRadius="8" Color="#0066FF" Opacity="0.6"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <!-- Indeterminate State -->
                                <Trigger Property="IsChecked" Value="{x:Null}">
                                    <Setter TargetName="BoxBorder" Property="Background" Value="#0066FF"/>
                                    <Setter TargetName="BoxBorder" Property="BorderBrush" Value="#00D2FF"/>
                                    <Setter TargetName="IndeterminateGlyph" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="BoxBorder" Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect ShadowDepth="0" BlurRadius="6" Color="#0066FF" Opacity="0.5"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <!-- Mouse Over -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="BoxBorder" Property="BorderBrush" Value="#00D2FF"/>
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsMouseOver" Value="True"/>
                                        <Condition Property="IsChecked" Value="False"/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="BoxBorder" Property="Background" Value="#0F2440"/>
                                </MultiTrigger>
                                <!-- Disabled -->
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="RootGrid" Property="Opacity" Value="0.4"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Navigation Icon Button -->
            <Style x:Key="NavIconButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="4"/>
                <Setter Property="Width" Value="30"/>
                <Setter Property="Height" Value="30"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#15FFFFFF"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="#25FFFFFF"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.3"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Dark Search TextBox -->
            <Style x:Key="DarkSearchBox" TargetType="TextBox">
                <Setter Property="Background" Value="#0D1B30"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Height" Value="28"/>
                <Setter Property="Padding" Value="24,4,6,4"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="CaretBrush" Value="{StaticResource NeonCyan}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                <Grid VerticalAlignment="Center">
                                    <TextBlock Text="Filtrar..." Foreground="{StaticResource TextMuted}" FontSize="11"
                                               Margin="24,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Margin="0"/>
                                </Grid>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Dark Metric Badge Pill -->
            <Style x:Key="MetricBadge" TargetType="Border">
                <Setter Property="Background" Value="#0D1B30"/>
                <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="12,6"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
            </Style>

            <!-- Breadcrumb Button -->
            <Style x:Key="BreadcrumbButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="4,2"/>
                <Setter Property="Height" Value="24"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource NeonCyan}"/>
                                    <Setter Property="Background" Value="#10FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ListView Item Style (File Row) -->
            <Style x:Key="FileRowStyle" TargetType="ListViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                <Setter Property="Padding" Value="0,3"/>
                <Setter Property="Margin" Value="0"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListViewItem">
                            <Border x:Name="Bd" Background="Transparent" BorderBrush="#0B1A30" 
                                    BorderThickness="0,0,0,1" Padding="{TemplateBinding Padding}">
                                <GridViewRowPresenter VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#0D2A50"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#0F2F5A"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#1A4080"/>
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsSelected" Value="True"/>
                                        <Condition Property="IsMouseOver" Value="True"/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="Bd" Property="Background" Value="#12356A"/>
                                </MultiTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- GridView Column Header Style -->
            <Style x:Key="DarkColumnHeader" TargetType="GridViewColumnHeader">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="BorderBrush" Value="#15FFFFFF"/>
                <Setter Property="Padding" Value="8,6"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="GridViewColumnHeader">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                    BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Footer Select Button -->
            <Style x:Key="FooterSelectButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="FontSize" Value="10"/>
                <Setter Property="Height" Value="22"/>
                <Setter Property="Padding" Value="6,0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource NeonCyan}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ViewToggle Button -->
            <Style x:Key="ViewToggleButton" TargetType="Border">
                <Setter Property="Background" Value="#10FFFFFF"/>
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="Padding" Value="5,3"/>
                <Setter Property="Margin" Value="2,0"/>
                <Setter Property="Cursor" Value="Hand"/>
            </Style>

            <!-- Window Control Button Base -->
            <Style x:Key="WindowControlButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Width" Value="36"/>
                <Setter Property="Height" Value="32"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#20FFFFFF"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#30FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Window Close Button Style (Red Hover) -->
            <Style x:Key="WindowCloseButton" TargetType="Button" BasedOn="{StaticResource WindowControlButton}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#E53935"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#B71C1C"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>