<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- Estilos para botões -->
    <Style Selector="Button">
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Margin" Value="2" />
        <Setter Property="MinWidth" Value="80" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    
    <Style Selector="Button.accent">
        <Setter Property="Background" Value="{DynamicResource SystemAccentBrush}" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    
    <Style Selector="Button:disabled">
        <Setter Property="Opacity" Value="0.5" />
    </Style>
    
    <Style Selector="TextBox">
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="Margin" Value="2" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>
    
    <Style Selector="DataGrid">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="RowBackground" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    
    <Style Selector="ProgressBar">
        <Setter Property="Height" Value="16" />
        <Setter Property="Margin" Value="0,4" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>
    
    <!-- Cores de tema e área de Drop -->
    <Style Selector="Border.DropArea">
        <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltMediumBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="24,16" />
    </Style>
    
    <Style Selector="Border.DropArea:dragover">
        <Setter Property="Background" Value="{DynamicResource SystemControlHighlightBaseMediumLowBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColorDark1Brush}" />
    </Style>
</Styles>