<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:PreservaMetadados"
             xmlns:converters="using:PreservaMetadados.Converters"
             x:Class="PreservaMetadados.App"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <ResourceDictionary>
            <converters:EnumToBooleanConverter x:Key="EnumEqualConverter" />
            <ResourceDictionary.ThemeDictionaries>
                <ResourceInclude x:Key="Dark" Source="/Themes/DarkTheme.axaml" />
                <ResourceInclude x:Key="Light" Source="/Themes/LightTheme.axaml" />
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>
        <StyleInclude Source="/Assets/styles.axaml" />
    </Application.Styles>
</Application>
