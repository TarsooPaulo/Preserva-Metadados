<Window x:Class="PreservaMetadados.ConflictDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Conflito de Transferência"
        Width="520"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        MouseDown="Window_MouseDown">

    <Border Background="{StaticResource CardBackground}" CornerRadius="12" 
            BorderBrush="{StaticResource CardBorder}" BorderThickness="1.5" Padding="22">
        <Border.Effect>
            <DropShadowEffect ShadowDepth="0" BlurRadius="25" Color="#0066FF" Opacity="0.45"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                <Border Width="36" Height="36" CornerRadius="8" Background="#20FFD54F" Margin="0,0,12,0" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="AlertCircleOutline" Width="22" Height="22" Foreground="#FFD54F" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="O Item Já Existe no Destino" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                    <TextBlock Text="Escolha como deseja prosseguir com a transferência" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                </StackPanel>
            </StackPanel>

            <!-- Message Prompt -->
            <Border Grid.Row="1" Background="#0D1B30" CornerRadius="8" Padding="14,12" Margin="0,0,0,14" BorderBrush="{StaticResource CardBorder}" BorderThickness="1">
                <TextBlock x:Name="TxtMessage" TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource TextPrimary}" LineHeight="20"/>
            </Border>

            <!-- Checkbox: Apply to all -->
            <CheckBox Grid.Row="2" x:Name="ChkApplyToAll"
                      Content="Fazer isso para todos os itens"
                      Style="{StaticResource DarkCheckBox}"
                      HorizontalAlignment="Left"
                      Margin="0,15,0,15"
                      Foreground="{StaticResource TextSecondary}"
                      FontSize="12"/>

            <!-- Action Buttons -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Sobrescrever (Substituir) -->
                <Button Grid.Column="1" x:Name="BtnOverwrite" Click="BtnOverwrite_Click"
                        Style="{StaticResource GlowButton}" Background="{StaticResource BlueButtonGradient}"
                        Height="38" Padding="16,0" Margin="0,0,8,0" IsDefault="True">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="FileReplaceOutline" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Sobrescrever" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Pular -->
                <Button Grid.Column="2" x:Name="BtnSkip" Click="BtnSkip_Click"
                        Height="38" Padding="16,0" Margin="0,0,8,0" Cursor="Hand"
                        Background="#15FFFFFF" Foreground="{StaticResource TextPrimary}" BorderBrush="#30FFFFFF" BorderThickness="1">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="SkipNext" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}"/>
                                    <TextBlock Text="Pular" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#25FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Cancelar -->
                <Button Grid.Column="3" x:Name="BtnCancel" Click="BtnCancel_Click" IsCancel="True"
                        Height="38" Padding="16,0" Cursor="Hand"
                        Background="#20E53935" Foreground="#FF8A80" BorderBrush="#E53935" BorderThickness="1">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="CloseCircleOutline" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="#FF8A80"/>
                                    <TextBlock Text="Cancelar" FontWeight="SemiBold" FontSize="12" Foreground="#FF8A80" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#35E53935"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
